<%# New post form %>
<section class="bg-white/5 border border-white/10 p-5 mb-8">
  <h2 class="text-base font-semibold text-white mb-3">Bericht plaatsen</h2>
  <%= form_with model: @post, url: posts_path, class: "space-y-3" do |f| %>
    <% if @post.errors.any? %>
      <div class="border border-red-400/40 bg-red-900/30 text-red-300 px-4 py-2 text-sm">
        <%= @post.errors.full_messages.to_sentence %>
      </div>
    <% end %>
    <%= f.text_field :title,
          placeholder: "Onderwerp (optioneel)",
          class: "w-full bg-white/5 border border-white/15 text-white placeholder-white/30 px-3 py-2 text-sm focus:outline-none focus:border-[#e8874a]" %>
    <%= f.text_area :content,
          placeholder: "Wat wil je delen met de buurt?",
          rows: 3,
          required: true,
          class: "w-full bg-white/5 border border-white/15 text-white placeholder-white/30 px-3 py-2 text-sm focus:outline-none focus:border-[#e8874a]" %>
    <div class="flex items-center gap-3">
      <%= f.text_field :author,
            placeholder: "Naam (of laat leeg)",
            class: "flex-1 bg-white/5 border border-white/15 text-white placeholder-white/30 px-3 py-2 text-sm focus:outline-none focus:border-[#e8874a]" %>
      <%= f.submit "Plaatsen →",
            class: "bg-[#e8874a] hover:bg-[#d97840] text-white font-semibold px-5 py-2 text-sm cursor-pointer transition-colors" %>
    </div>
  <% end %>
</section>

<%# Live post feed %>
<section>
  <h2 class="text-sm font-semibold text-white/40 uppercase tracking-wider mb-3">Berichten</h2>
  <%= turbo_stream_from "posts" %>
  <div id="posts" class="space-y-3">
    <%= render @posts %>
  </div>
  <% if @posts.empty? %>
    <p class="text-white/30 py-10 text-sm">Nog geen berichten. Wees de eerste!</p>
  <% end %>
</section>
